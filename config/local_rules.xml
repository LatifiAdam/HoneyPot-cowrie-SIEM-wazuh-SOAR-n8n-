<!--
  Example Cowrie rules used in this lab.
  Check for rule-ID collisions before adding to an existing local_rules.xml.
  Validate with wazuh-logtest against real Cowrie events before deployment.
-->
<group name="local,cowrie,">
  <rule id="100501" level="7">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <description>Cowrie: Failed SSH login.</description>
    <group>cowrie,authentication_failed,</group>
  </rule>

  <rule id="100502" level="10">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <description>Cowrie: Successful simulated SSH login.</description>
    <group>cowrie,authentication_success,</group>
  </rule>

  <rule id="100503" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.command\.input$</field>
    <description>Cowrie: Command entered in the honeypot session.</description>
    <group>cowrie,command_execution,</group>
  </rule>

  <rule id="100504" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100501</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: Five or more failed SSH logins from the same source within 60 seconds.</description>
    <group>cowrie,brute_force,</group>
  </rule>
</group>
